PORT=3000

# Obtain the development connection URL from the database team.
# Leave blank until available; the HTTP server runs without it.
DATABASE_URL=

# Optional: a separate database whose name ends in _test, for the database tests (npm test).
# The tests drop and rebuild its schema, so never point it at the shared database.
TEST_DATABASE_URL=

# Path to your local Firebase service-account JSON file (never commit the key).
GOOGLE_APPLICATION_CREDENTIALS=
