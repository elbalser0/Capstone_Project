# true: answer /api in the browser from src/mocks (dummy data, no backend needed)
# false: send /api to the Express backend through the Vite proxy (http://localhost:3000)
VITE_USE_MOCKS=true

# demo: sign in with a demo account email (any password) until Firebase is configured
VITE_AUTH_MODE=demo

# firebase: sign in with Firebase email/password. Needs VITE_USE_MOCKS=false and the backend running.
# These browser settings are public identifiers; the backend verifies the ID token.
# VITE_AUTH_MODE=firebase
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
